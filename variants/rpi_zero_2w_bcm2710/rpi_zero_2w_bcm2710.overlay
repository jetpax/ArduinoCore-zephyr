 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Arduino variant overlay for the Raspberry Pi Zero 2 W (BCM2710A1,
 * Cortex-A53, aarch64). Sketches load from a FAT file on the SD card
 * via Zephyr's fs llext loader -- there is no internal flash and no
 * `user_sketch` partition. See notes/pizza-arduino-phase0.md for the
 * full design.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/* SPI0 full bus on GPIO 9 (MISO), 10 (MOSI), 11 (SCLK), with CE0 on
 * GPIO 8 driven as a GPIO chip-select. The board DTS enables `&spi0`
 * but leaves pinctrl to the application overlay, by design.
 */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_gpio7>;
	cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
	status = "okay";
};

/* VideoCore mailbox + firmware: the USB PHY on this SoC is powered on via a
 * VC SET_POWER_STATE mailbox call, so both must be enabled before the dwc2
 * controller can enumerate. (Proven on the Phase-6 cdc-loader spike.)
 */
&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

/* USB device controller (snps,dwc2). The bcm2710 dtsi labels this node both
 * `usb` and `zephyr_udc0`; the Arduino core binds its single USBD context to
 * DT_NODELABEL(zephyr_udc0). The CDC ACM child is the board's `Serial` -- the
 * loader owns USB bring-up and the upload channel, see the variant .conf
 * (CONFIG_ARDUINO_USB_LOADER_OWNED) and loader/main.c.
 */
&zephyr_udc0 {
	status = "okay";

	board_cdc_acm_uart: board_cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* BCM283x PWM block -- channel 0 on GPIO 12 (header pin 32), channel 1
 * on GPIO 13 (header pin 33), both ALT0: the conflict-free pair (no
 * overlap with I2S, analog/HDMI audio, the UART console or the ACT
 * LED). Deferred init + the "arduino" pinctrl state follow the
 * upstream giga convention: the core's analogWrite() calls
 * device_init() on first use and muxes just the one channel's pin
 * back to PWM after any digitalWrite() flipped it to GPIO.
 */
&pwm0 {
	status = "okay";
	zephyr,deferred-init;
	/* Single "arduino" state, no "default": the BCM pinctrl takes
	 * exactly ONE group phandle per state, and the driver skips a
	 * missing default (-ENOENT tolerated), so nothing muxes until
	 * the first analogWrite(). pwm_gpio12's pin order (GPIO 12,
	 * GPIO 13) is the per-channel index the core uses.
	 */
	pinctrl-0 = <&pwm_gpio12>;
	pinctrl-names = "arduino";
};

/* BCM283x PCM / I2S block on GPIO 18 (BCK), 19 (LRCK), 20 (DIN),
 * 21 (DOUT), all ALT0 -- header pins 12/35/38/40. Unlike PWM there is
 * no per-channel pin dance (none of these GPIOs are in the digital pin
 * map), so a plain deferred "default" state suffices: nothing muxes at
 * boot, and the driver init applies it when the sketch's first
 * I2S.begin() runs device_init().
 */
&i2s {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&i2s_gpio18>;
	pinctrl-names = "default";
};

/ {
	fstab {
		compatible = "zephyr,fstab";

		sd: sd {
			compatible = "zephyr,fstab,fatfs";
			disk-access;
			automount;
			mount-point = "/SD:";
		};
	};

	zephyr,user {
		/*
		 * Arduino digital pin map for the Pi 40-pin header.
		 * D0/D1 follow the Arduino Uno convention (D0 = RX, D1 = TX);
		 * D10..D13 align with SPI0 so SPI sketches Just Work.
		 *
		 *   D0  = GPIO 15  (UART1 RX)         header pin 10
		 *   D1  = GPIO 14  (UART1 TX)         header pin 8
		 *   D2  = GPIO  4                     header pin 7
		 *   D3  = GPIO 17                     header pin 11
		 *   D4  = GPIO 27                     header pin 13
		 *   D5  = GPIO 22                     header pin 15
		 *   D6  = GPIO  5                     header pin 29
		 *   D7  = GPIO  6                     header pin 31
		 *   D8  = GPIO 23                     header pin 16
		 *   D9  = GPIO 24                     header pin 18
		 *   D10 = GPIO  8  (SPI0 CE0)         header pin 24
		 *   D11 = GPIO 10  (SPI0 MOSI)        header pin 19
		 *   D12 = GPIO  9  (SPI0 MISO)        header pin 21
		 *   D13 = GPIO 11  (SPI0 SCLK)        header pin 23
		 *   D14 = GPIO 29  (on-board ACT LED) no header pin
		 *   D15 = GPIO 12  (PWM0)             header pin 32
		 *   D16 = GPIO 13  (PWM1)             header pin 33
		 *
		 * D14 isn't on the 40-pin header -- it's the green on-board
		 * activity LED. The Pi Zero 2 W uses the Pi 3 family's
		 * LED location (GPIO 29) rather than the original Pi Zero W's
		 * GPIO 47 -- confirmed empirically 2026-06-06 (GPIO 47
		 * toggles cleanly at the register but doesn't light the
		 * board's LED; GPIO 29 does). We expose it as the Arduino
		 * BUILTIN LED so the standard Blink sketch
		 * (`digitalWrite(LED_BUILTIN, ...)`) blinks the on-board LED
		 * without requiring an external jumper to D13.
		 * ArduinoCore-zephyr's `LED_BUILTIN` macro
		 * (cores/arduino/Arduino.h:54-67) finds the matching entry
		 * in `digital-pin-gpios` and returns its index -- so
		 * `LED_BUILTIN` resolves to `14`.
		 *
		 * NOTE: a separate variant directory for the original Pi
		 * Zero W (BCM2835, ARMv6) will use `<&gpio1 19>` (GPIO 47)
		 * for its on-board LED.
		 */
		digital-pin-gpios = <&gpio0 15 0>,
				    <&gpio0 14 0>,
				    <&gpio0  4 0>,
				    <&gpio0 17 0>,
				    <&gpio0 27 0>,
				    <&gpio0 22 0>,
				    <&gpio0  5 0>,
				    <&gpio0  6 0>,
				    <&gpio0 23 0>,
				    <&gpio0 24 0>,
				    <&gpio0  8 0>,
				    <&gpio0 10 0>,
				    <&gpio0  9 0>,
				    <&gpio0 11 0>,
				    <&gpio1  1 0>,
				    <&gpio0 12 0>,
				    <&gpio0 13 0>;

		/* On-board ACT LED -- BCM GPIO 29, ACTIVE_HIGH. */
		builtin-led-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;

		/*
		 * `Serial` is the USB CDC ACM device (matching every other
		 * Arduino USB board): it carries both the sketch's serial I/O
		 * and the Phase-6 upload channel. The presence of
		 * `cdc-acm-serial` makes ArduinoCore's ZARD_FIRST_SERIAL_IS_SERIALUSB
		 * true, so `Serial` is a SerialUSB_ on this node.
		 *
		 * The board's mini-UART (uart1 @ GPIO 14/15, 115200) drops to
		 * `Serial1` and remains the console + LOG_* backend (chosen
		 * zephyr,console in the board DTS). Higher `SerialN` slots are
		 * unbound until a second UART gets wired.
		 */
		cdc-acm-serial = <&board_cdc_acm_uart>;
		serials = <&uart1>;

		/* Wire = BSC1 ("I2C1") at GPIO 2 (SDA) / GPIO 3 (SCL). */
		i2cs = <&i2c1>;

		/* SPI = SPI0 full bus, see &spi0 above. */
		spis = <&spi0>;

		/* I2S = the PCM block, see &i2s above. */
		i2ses = <&i2s>;

		/*
		 * Hardware PWM: analogWrite() works on D15 (GPIO 12) and
		 * D16 (GPIO 13) -- the BCM283x PWM block only reaches
		 * those two header pins (see &pwm0 above). The 490 Hz
		 * period matches the Arduino Uno's analogWrite frequency.
		 * On every other pin analogWrite() falls back to the
		 * upstream digital threshold behaviour (>= half scale ->
		 * HIGH). The pwms entry order pairs with the "arduino"
		 * pinctrl state's pin order in &pwm0.
		 */
		pwms = <&pwm0 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
		       <&pwm0 1 PWM_HZ(490) PWM_POLARITY_NORMAL>;
		pwm-pin-gpios = <&gpio0 12 0>, <&gpio0 13 0>;

		/*
		 * No ADC on this SoC -> `analogRead` is unavailable; no
		 * `adc-pin-gpios` / `io-channels` nodes by design.
		 */
	};
};
