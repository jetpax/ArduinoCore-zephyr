config PINCTRL
	select PINCTRL_NON_STATIC

source "Kconfig.zephyr"

config LLEXT_HEAP_REGION
	string "LLEXT heap memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for LLEXT heap.

config MAIN_STACK_REGION
	string "Main stack memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for main stack.

config ARDUINO_SKETCH_LOADER_FS
	bool "Load the sketch as an llext from a file system path"
	depends on LLEXT && FILE_SYSTEM
	help
	  Replace the default flash-partition sketch loader with one that
	  opens a file on a mounted file system (e.g. SD-FAT) via Zephyr's
	  llext fs_loader. Use this on targets with no internal flash, such
	  as the Raspberry Pi family boards.

config ARDUINO_SKETCH_LOADER_FS_PATH
	string "Sketch file system path"
	depends on ARDUINO_SKETCH_LOADER_FS
	default "/SD:/sketch.llext"
	help
	  Absolute path to the sketch .llext file on the mounted file system.

config ARDUINO_SKETCH_LOADER_CDC_UPLOAD
	bool "In-process CDC upload + swap (no reboot)"
	depends on ARDUINO_SKETCH_LOADER_FS && USB_DEVICE_STACK_NEXT && USBD_CDC_ACM_CLASS
	select RING_BUFFER
	select UART_LINE_CTRL
	help
	  The loader owns USBD/CDC: it brings USB up at boot, runs the sketch in
	  its own thread, and watches the CDC line for the IDE's 1200-bps upload
	  touch. On the touch it aborts the sketch, receives a fresh sketch.llext
	  over CDC, writes it to the (firmware-owned) file system, and starts it
	  in-process -- no reboot. For SoCs with no sys_reboot, such as the
	  BCM2710 / Raspberry Pi Zero 2 W. Pairs with CONFIG_ARDUINO_USB_LOADER_OWNED
	  on the sketch side.
