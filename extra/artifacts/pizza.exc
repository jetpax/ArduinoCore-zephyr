# Files listed here will not be installed with this artifact.
# This file has precedence over inclusion.

# No backing drivers wired in the rpi_zero_2w_bcm2710 variant overlay.
# (WiFi is kept -- the brcmfmac driver works on this board.)
libraries/Camera/
libraries/Storage/
libraries/Zephyr_SDRAM/
libraries/Ethernet/
libraries/CAN/
libraries/Arduino_LED_Matrix/
# No RTC peripheral on this SoC -- there is no rtc node in the bcm2710 DTS, so
# the RTC library has no device to bind. (CONFIG_RTC is on in the loader's
# prj.conf but inert without a device.)
libraries/RTC/
